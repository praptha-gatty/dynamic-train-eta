# ============================================================
# DYNAMIC TRAIN ETA BACKEND - ENVIRONMENT CONFIGURATION
# ============================================================
# Copy this file to .env and fill in your values
# ============================================================

# Server Configuration
PORT=3000
NODE_ENV=development
API_PREFIX=/api/v1

# Supabase Configuration
# Get these from your Supabase project settings > API
SUPABASE_URL=https://rwkcsfdmfhaxsaetzuzj.supabase.co
SUPABASE_ANON_KEY=sb_publishable_i4cahjdwkuyHW0Ir4_vvEA_cRCmZp1b
SUPABASE_SERVICE_ROLE_KEY=sb_secret_IV9zf5w44nNC-jXfcNv9_w_035SE1nH

# RailRadar API Configuration
# Get this from railradar.in developer portal
RAILRADAR_API_KEY=rg_aa7284a9950447b1b7e99b838d822529

# CORS Configuration
# Comma-separated list of allowed origins
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# WebSocket Configuration
WS_ENABLED=true
WS_PING_INTERVAL=25000
WS_PING_TIMEOUT=20000

# Logging
LOG_LEVEL=info
LOG_FILE=logs/app.log

# Cache Configuration (optional - for Redis)
# REDIS_URL=redis://localhost:6379
# CACHE_TTL_SECONDS=300

# ETA Prediction Model (optional)
# ML_MODEL_URL=http://localhost:8000/predict
# ML_MODEL_API_KEY=your-ml-api-key