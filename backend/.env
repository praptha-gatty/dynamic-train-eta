# ============================================================
# DYNAMIC TRAIN ETA BACKEND - ENVIRONMENT CONFIGURATION
# ============================================================

# Server Configuration
PORT=3000
NODE_ENV=development
API_PREFIX=/api/v1

# Supabase Configuration
# Get from: Supabase Dashboard > Settings > API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=sb_publishable_i4cahjdwkuyHW0Ir4_vvEA_cRCmZp1b
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# RailRadar API Configuration
# Get from: railradar.in developer portal
RAILRADAR_API_KEY=rg_aa7284a9950447b1b7e99b838d822529

# CORS Configuration
# Your frontend URL(s) - comma separated
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# WebSocket Configuration
WS_ENABLED=true
WS_PING_INTERVAL=25000
WS_PING_TIMEOUT=20000

# Logging
LOG_LEVEL=info
